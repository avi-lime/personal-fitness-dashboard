# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development (see README for the Docker one-liner):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/life_dashboard"
# Production (Vercel Postgres / Neon / Supabase): use the *pooled* URL.

# --- Personal authentication -----------------------------------------------
# The single account that owns all data in this deployment.
AUTH_USERNAME="owner"
# Password used at /login. Use a long random string.
AUTH_PASSWORD="change-me-to-a-long-random-password"
# Signing key for the session cookie. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="generate-a-random-48-byte-base64-string-at-least-32-chars"

# --- MCP endpoint ----------------------------------------------------------
# Bearer token an MCP client must present at /api/mcp.
# Leave unset to disable the MCP endpoint entirely. Generate with:
#   openssl rand -hex 32
MCP_TOKEN="generate-a-random-32-byte-hex-token"

# --- Voice / text assistant --------------------------------------------------
# API key for the model that powers the in-app assistant. Leave unset to hide
# the assistant entirely. Default provider is Google Gemini (free tier):
#   https://aistudio.google.com/apikey
# Note: Google may use free-tier prompts for training; use a paid key or another
# OpenAI-compatible provider if that matters to you.
ASSISTANT_API_KEY="your-gemini-api-key"
# Any OpenAI-compatible chat endpoint. Defaults to Gemini's when unset.
# ASSISTANT_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# ASSISTANT_MODEL="gemini-3.8-flash"
